# ─────────────────────────────────────────────────────────────
# ROCKET RIFT: FRONTIER — environment template
# Copy to .env and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgres://rift:rift@localhost:5432/rocket_rift
PGSSLMODE=disable

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Session / anti-cheat signing ─────────────────────────────
# 32+ byte random hex. Used for HMAC session payloads + nonce signing.
SESSION_HMAC_SECRET=change_me_to_a_long_random_hex_string
JWT_SECRET=change_me_to_another_long_random_hex_string
SESSION_TTL_SECONDS=3600

# ── Chain / Web3 ─────────────────────────────────────────────
CHAIN_ID=11155111
# Public Sepolia endpoint (no API key needed). Swap for Alchemy/Infura in prod.
# NOTE: https://rpc.sepolia.org is dead — it returns an Apache 404.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SHIP_NFT_ADDRESS=0x0000000000000000000000000000000000000000
ITEM_NFT_ADDRESS=0x0000000000000000000000000000000000000000
MARKETPLACE_ADDRESS=0x0000000000000000000000000000000000000000

# ── Contracts (deploy) ───────────────────────────────────────
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
MARKETPLACE_FEE_BPS=250

# ── Client (Vite) ────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
VITE_CHAIN_ID=11155111
VITE_WALLETCONNECT_PROJECT_ID=
VITE_SHIP_NFT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ITEM_NFT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MARKETPLACE_ADDRESS=0x0000000000000000000000000000000000000000
