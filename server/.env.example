# ─────────────────────────────────────────────────────────────────────────────
# ROCKET RIFT: FRONTIER — server environment template
# Copy to server/.env and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://rift:rift@localhost:5432/rocket_rift
PGSSLMODE=disable

# ── Redis (optional) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Session / anti-cheat signing ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_HMAC_SECRET=change_me_to_a_long_random_hex_string
JWT_SECRET=change_me_to_another_long_random_hex_string
SESSION_TTL_SECONDS=3600

# ── Chain / Web3 ─────────────────────────────────────────────────────────────
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SHIP_NFT_ADDRESS=0x0000000000000000000000000000000000000000
ITEM_NFT_ADDRESS=0x0000000000000000000000000000000000000000
MARKETPLACE_ADDRESS=0x0000000000000000000000000000000000000000

# ── Contracts (deploy only) ──────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
MARKETPLACE_FEE_BPS=250
