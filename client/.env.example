# ─────────────────────────────────────────────────────────────────────────────
# ROCKET RIFT: FRONTIER — client environment template
# Copy to client/.env and fill in. Vite inlines these at build time.
# ─────────────────────────────────────────────────────────────────────────────

# ── Game server ──────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws

# ── Chain / contracts ────────────────────────────────────────────────────────
# Written automatically by:
#   WRITE_ENV=1 npm run deploy:sepolia --workspace contracts
VITE_CHAIN_ID=11155111
VITE_SHIP_NFT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ITEM_NFT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MARKETPLACE_ADDRESS=0x0000000000000000000000000000000000000000

# ── Optional ─────────────────────────────────────────────────────────────────
VITE_WALLETCONNECT_PROJECT_ID=
